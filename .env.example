# App mode
DATAVERSE_MODE=live

# Dataverse organization settings
DATAVERSE_URL=https://your-org.crm.dynamics.com
DATAVERSE_TENANT_ID=your-tenant-id
DATAVERSE_CLIENT_ID=your-client-id
DATAVERSE_CLIENT_SECRET=your-client-secret
DATAVERSE_API_VERSION=v9.2
DATAVERSE_CASES_LOGICAL_NAME=svh_cases

# Dataverse entity sets
DATAVERSE_CASES_ENTITY_SET=svh_caseses
DATAVERSE_AUDIT_ENTITY_SET=svh_case_audit_eventses

# Case table field schema names
DATAVERSE_CASE_ID_FIELD=svh_caseid
DATAVERSE_SECRET_HASH_FIELD=svh_secrethash
DATAVERSE_CATEGORY_FIELD=svh_category
DATAVERSE_CATEGORY_OPTION_MAP={"fraud":925010001,"corruption":925010002,"misconduct":925010003,"other":925010004,"harassment":925010005}
DATAVERSE_TITLE_FIELD=svh_title
DATAVERSE_DESCRIPTION_FIELD=svh_description
DATAVERSE_INCIDENT_DATE_FIELD=svh_incidentdate
DATAVERSE_LOCATION_FIELD=svh_location
DATAVERSE_PEOPLE_INVOLVED_FIELD=svh_peopleinvolved
DATAVERSE_EVIDENCE_NOTES_FIELD=svh_evidencenotes
DATAVERSE_RAISED_THROUGH_NORMAL_CHANNELS_FIELD=svh_raisedthroughnormalchannels
DATAVERSE_NORMAL_CHANNEL_ACTION_SUMMARY_FIELD=svh_normalchannelactionsummary
DATAVERSE_PRESIDENTIAL_ESCALATION_REASON_FIELD=svh_presidentialescalationreason
DATAVERSE_PRESIDENTIAL_ESCALATION_FACTORS_FIELD=svh_presidentialescalationfactors
DATAVERSE_PRESIDENTIAL_ESCALATION_FACTORS_OPTION_MAP=
DATAVERSE_PRESIDENTIAL_ESCALATION_OTHER_DETAIL_FIELD=svh_presidentialescalationotherdetail
DATAVERSE_POTENTIAL_IMPACT_FIELD=svh_potentialimpact
DATAVERSE_POTENTIAL_IMPACT_OPTION_MAP=
DATAVERSE_URGENCY_FIELD=svh_urgency
DATAVERSE_URGENCY_OPTION_MAP=
DATAVERSE_STATUS_FIELD=svh_status
DATAVERSE_STATUS_OPTION_MAP={"new":925010001,"triage":925010002,"investigating":925010003,"waiting_for_reporter":925010004,"resolved":925010005,"closed":925010006}
DATAVERSE_SUBMITTED_AT_FIELD=svh_submissiondate
DATAVERSE_REPORTER_EMAIL_FIELD=svh_reporteremail
DATAVERSE_CONFIDENTIALITY_FIELD=svh_confidentialityaccepted
DATAVERSE_CONSENT_FIELD=svh_consentaccepted

# Audit table field schema names
DATAVERSE_AUDIT_CASE_ID_FIELD=svh_caseid
DATAVERSE_AUDIT_EVENT_TYPE_FIELD=svh_eventtype
DATAVERSE_AUDIT_ACTOR_TYPE_FIELD=svh_actortype
DATAVERSE_AUDIT_SUMMARY_FIELD=svh_summary
DATAVERSE_AUDIT_CREATED_AT_FIELD=svh_createdat

# SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Reporter portal URL used in email links
REPORTER_PORTAL_URL=http://localhost:5173
# Optional private server folder for uploaded evidence files.
# Defaults to ~/svh-speakup-evidence on cPanel/Linux.
EVIDENCE_UPLOAD_DIR=
# Investigator portal URL used for production CORS allow-listing
INVESTIGATOR_PORTAL_URL=http://localhost:5174
# Optional comma-separated extra origins if you host behind different domains
CORS_ALLOWED_ORIGINS=

# Investigator portal authentication
# Enable after you create the Entra app registrations and allowed access rules.
INVESTIGATOR_AUTH_ENABLED=false
INVESTIGATOR_ENTRA_TENANT_ID=
# Comma-separated list of valid audiences for the API access token.
# In most setups this is the API app registration client ID.
INVESTIGATOR_API_AUDIENCES=
# Use one or more of these to control who can access the investigator routes.
INVESTIGATOR_ALLOWED_GROUP_IDS=
INVESTIGATOR_ALLOWED_ROLE_VALUES=
INVESTIGATOR_ALLOWED_USER_OIDS=

# Investigator SPA (Vite-exposed values)
VITE_API_BASE_URL=http://localhost:3001
VITE_INVESTIGATOR_ENTRA_TENANT_ID=
VITE_INVESTIGATOR_ENTRA_CLIENT_ID=
# The protected API scope exposed by the API app registration, for example:
# api://<api-app-client-id>/investigator.read
VITE_INVESTIGATOR_API_SCOPE=
