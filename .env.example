# App mode
DATAVERSE_MODE=live

# Dataverse organization settings
DATAVERSE_URL=https://your-org.crm.dynamics.com
DATAVERSE_TENANT_ID=your-tenant-id
DATAVERSE_CLIENT_ID=your-client-id
DATAVERSE_CLIENT_SECRET=your-client-secret
DATAVERSE_API_VERSION=v9.2

# Dataverse entity sets
DATAVERSE_CASES_ENTITY_SET=svh_caseses
DATAVERSE_AUDIT_ENTITY_SET=svh_case_audit_eventses

# Case table field schema names
DATAVERSE_CASE_ID_FIELD=svh_caseid
DATAVERSE_SECRET_HASH_FIELD=svh_secrethash
DATAVERSE_CATEGORY_FIELD=svh_category
DATAVERSE_TITLE_FIELD=svh_title
DATAVERSE_DESCRIPTION_FIELD=svh_description
DATAVERSE_INCIDENT_DATE_FIELD=svh_incidentdatetext
DATAVERSE_LOCATION_FIELD=svh_locationtext
DATAVERSE_PEOPLE_INVOLVED_FIELD=svh_peopleinvolved
DATAVERSE_EVIDENCE_NOTES_FIELD=svh_evidencenotes
DATAVERSE_STATUS_FIELD=svh_status
DATAVERSE_SUBMITTED_AT_FIELD=svh_submittedat
DATAVERSE_REPORTER_EMAIL_FIELD=svh_reporteremail
DATAVERSE_CONFIDENTIALITY_FIELD=svh_confidentialityaccepted
DATAVERSE_CONSENT_FIELD=svh_consentaccepted

# Audit table field schema names
DATAVERSE_AUDIT_CASE_ID_FIELD=svh_caseid
DATAVERSE_AUDIT_EVENT_TYPE_FIELD=svh_eventtype
DATAVERSE_AUDIT_ACTOR_TYPE_FIELD=svh_actortype
DATAVERSE_AUDIT_SUMMARY_FIELD=svh_summary
DATAVERSE_AUDIT_CREATED_AT_FIELD=svh_createdat

# SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=